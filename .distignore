# Distribution Ignore File
# Files and folders to exclude from the WordPress.org plugin distribution

# Git and GitHub
.git
.github
.gitignore
.gitattributes

# Development files
.phpunit.cache
.editorconfig
.npmrc
.DS_Store
coverage/
*.zip
*.cdx.json

# Build tools and package-manager metadata
node_modules
vendor/
package.json
package-lock.json
composer.json
composer.lock
webpack.config.js
vitest.config.js
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
i18n-map.json

# Source JavaScript/CSS files (compiled versions are in build/)
src/admin/
src/editor/
src/shared/

# Tests, security metadata, and maintenance scripts
tests/
security/
scripts/

# Internal documentation and repository governance
assets/
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
UPSTREAM.md

# This file
.distignore

# WordPress.org assets (goes in separate svn assets folder)
.wordpress-org/
