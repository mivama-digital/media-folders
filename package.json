{
	"name": "virtual-media-folders",
	"version": "2.1.6",
	"description": "Virtual folder organization and smart management for the WordPress Media Library.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "webpack --mode production --config webpack.config.js",
		"start": "webpack --mode development --watch --config webpack.config.js",
		"test": "vitest",
		"i18n": "npm run i18n:make-pot && npm run i18n:update-po && npm run i18n:make-mo && npm run i18n:make-json && npm run i18n:make-php",
		"i18n:make-pot": "wp i18n make-pot . languages/virtual-media-folders.pot --exclude=node_modules,vendor,tests,build --domain=virtual-media-folders",
		"i18n:update-po": "wp i18n update-po languages/virtual-media-folders.pot languages/",
		"i18n:make-mo": "wp i18n make-mo languages/",
		"i18n:make-json": "wp i18n make-json languages/ --no-purge --use-map=i18n-map.json && node -e \"const fs=require('fs'),path='languages/';fs.readdirSync(path).filter(f=>f.endsWith('.json')&&f.includes('1f555e4860f98635501ddff67922e0d5')).forEach(f=>{const content=JSON.parse(fs.readFileSync(path+f));content.source='build/admin.js';fs.writeFileSync(path+f.replace('1f555e4860f98635501ddff67922e0d5','aa377c165c6b87664fc2deacf28cbe53'),JSON.stringify(content));fs.unlinkSync(path+f)})\"",
		"i18n:make-php": "wp i18n make-php languages/",
		"security:audit": "npm audit",
		"security:audit:high": "npm audit --audit-level=high",
		"security:audit:runtime": "npm audit --omit=dev --audit-level=low",
		"security:audit:dev-baseline": "node scripts/check-dev-audit-baseline.mjs",
		"security:install-scripts": "node scripts/check-install-script-policy.mjs",
		"check:engines": "node scripts/check-engines.mjs",
		"check:licenses": "node scripts/check-licenses.mjs",
		"check:php-runtime-autoload": "php scripts/check-runtime-autoload.php",
		"check:bundle-budget": "node scripts/check-bundle-budget.mjs",
		"check:release-version": "node scripts/check-release-version.mjs",
		"package:zip": "bash scripts/build-release-zip.sh",
		"sbom:npm": "npm sbom --omit=dev --sbom-format=cyclonedx --sbom-type=application",
		"sbom:composer": "node scripts/generate-composer-sbom.mjs",
		"deps:outdated": "npm outdated",
		"deps:tree": "npm ls --all"
	},
	"devDependencies": {
		"@babel/core": "^7.25.7",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.6",
		"@vitejs/plugin-react": "^6.1.1",
		"@wordpress/babel-preset-default": "^8.54.0",
		"@wordpress/browserslist-config": "^6.54.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^6.54.0",
		"@wordpress/postcss-plugins-preset": "^5.54.0",
		"babel-loader": "^10.1.1",
		"browserslist": "^4.28.4",
		"css-loader": "^7.1.5",
		"cssnano": "^9.0.1",
		"jsdom": "^30.0.1",
		"mini-css-extract-plugin": "^2.9.2",
		"postcss": "^8.4.38",
		"postcss-loader": "^8.2.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rtlcss": "^4.3.0",
		"sass-embedded": "^1.103.1",
		"sass-loader": "^17.0.0",
		"terser-webpack-plugin": "^5.3.10",
		"vitest": "^4.1.11",
		"webpack": "^5.108.1",
		"webpack-cli": "^7.2.3"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@wordpress/api-fetch": "7.54.0",
		"@wordpress/data": "10.54.0",
		"@wordpress/element": "8.6.0",
		"@wordpress/i18n": "6.27.0",
		"@wordpress/icons": "15.5.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"core-js@3.50.0": true,
		"fsevents@2.3.3": true
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11 <12"
	},
	"packageManager": "npm@11.17.0"
}
